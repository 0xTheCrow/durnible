{
  "name": "durnible",
  "version": "1.0.1",
  "description": "",
  "main": "platform/desktop/dist/main.cjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xTheCrow/durnible.git"
  },
  "desktopName": "durnible.desktop",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "lint": "npm run fix:prettier && npm run check:eslint",
    "check:eslint": "eslint src",
    "check:prettier": "prettier --check .",
    "fix:prettier": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "performance": "playwright test --config playwright.performance.config.ts",
    "performance:production": "PERFORMANCE_TARGET=production playwright test --config playwright.performance.config.ts",
    "performance:trace": "PERFORMANCE_TRACE=1 playwright test --config playwright.performance.config.ts",
    "desktop:compile": "tsc -p platform/desktop/tsconfig.json",
    "desktop:dev": "npm run build && npm run desktop:compile && electron platform/desktop/dist/main.cjs",
    "desktop:build": "npm run build && npm run desktop:compile",
    "desktop:pack": "npm run desktop:build && electron-builder --dir",
    "desktop:dist": "npm run desktop:build && electron-builder",
    "mobile:sync": "npm run build && cap sync android",
    "mobile:build": "npm run mobile:sync && platform/mobile/android/gradlew -p platform/mobile/android assembleDebug",
    "mobile:run": "npm run mobile:sync && platform/mobile/runOnEmulator.sh",
    "prepare": "husky"
  },
  "keywords": [],
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "1.1.6",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "1.3.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "1.0.3",
    "@capacitor/core": "8.5.0",
    "@fontsource/inter": "4.5.14",
    "@tanstack/react-query": "5.24.1",
    "@tanstack/react-query-devtools": "5.24.1",
    "@tanstack/react-virtual": "3.2.0",
    "@vanilla-extract/css": "1.20.1",
    "@vanilla-extract/recipes": "0.5.7",
    "@vanilla-extract/vite-plugin": "5.2.2",
    "await-to-js": "3.0.0",
    "badwords-list": "2.0.1-4",
    "blurhash": "2.0.4",
    "browser-encrypt-attachment": "0.3.0",
    "chroma-js": "3.1.2",
    "classnames": "2.3.2",
    "dayjs": "1.11.10",
    "domhandler": "5.0.3",
    "electron-updater": "6.8.9",
    "emojibase": "15.3.1",
    "emojibase-data": "15.3.2",
    "file-saver": "2.0.5",
    "focus-trap-react": "10.0.2",
    "folds": "2.4.0",
    "html-dom-parser": "4.0.0",
    "html-react-parser": "4.2.0",
    "i18next": "23.12.2",
    "i18next-browser-languagedetector": "8.0.0",
    "i18next-http-backend": "3.0.6",
    "immer": "9.0.16",
    "is-hotkey": "0.2.0",
    "jotai": "2.6.0",
    "linkify-react": "4.3.2",
    "linkifyjs": "4.3.2",
    "livekit-client": "2.20.1",
    "matrix-js-sdk": "41.9.0",
    "millify": "6.1.0",
    "pdfjs-dist": "4.10.38",
    "prismjs": "1.30.0",
    "react": "18.2.0",
    "react-advanced-cropper": "0.20.1",
    "react-aria": "3.29.1",
    "react-blurhash": "0.2.0",
    "react-colorful": "5.6.1",
    "react-dom": "18.2.0",
    "react-error-boundary": "4.0.13",
    "react-google-recaptcha": "2.1.0",
    "react-i18next": "15.0.0",
    "react-range": "1.8.14",
    "react-router-dom": "7.18.2",
    "sanitize-html": "2.17.7",
    "ua-parser-js": "1.0.35"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/chroma-js": "3.1.1",
    "@types/file-saver": "2.0.5",
    "@types/is-hotkey": "0.1.10",
    "@types/node": "18.11.18",
    "@types/prismjs": "1.26.0",
    "@types/react": "18.2.39",
    "@types/react-dom": "18.2.17",
    "@types/react-google-recaptcha": "2.1.8",
    "@types/sanitize-html": "2.9.0",
    "@types/ua-parser-js": "0.7.36",
    "@typescript-eslint/eslint-plugin": "5.46.1",
    "@typescript-eslint/parser": "5.46.1",
    "@vitejs/plugin-react": "6.0.2",
    "buffer": "6.0.3",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "eslint": "8.29.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.6.1",
    "eslint-plugin-react": "7.31.11",
    "eslint-plugin-react-hooks": "4.6.0",
    "focus-trap": "7.6.4",
    "happy-dom": "20.11.12",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "2.8.1",
    "rollup-plugin-visualizer": "7.1.1",
    "typescript": "5.7.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-static-copy": "4.1.0",
    "vitest": "4.1.0",
    "workbox-expiration": "7.4.0",
    "workbox-precaching": "7.4.0"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,cjs,mjs}": [
      "prettier --write",
      "eslint"
    ],
    "!(*.{ts,tsx,js,jsx,cjs,mjs})": "prettier --write --ignore-unknown"
  }
}
