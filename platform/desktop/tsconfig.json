{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["main.cts", "preload.cts", "mediaAuth.cts", "screenshareAudio.cts", "windowState.cts"]
}
