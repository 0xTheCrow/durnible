# Copy to .env.local and set what you need.

# Origin of your Zoetrope GIF server. Without it the GIFs tab is absent.
VITE_GIF_SERVER_URL=https://gifs.example.com

# Set to the exact string "true" if your Matrix server delegates auth to an OIDC
# provider such as Matrix Authentication Service. When it is off, device
# management and verification use the legacy in-app flow instead of linking out
# to the provider's dashboard.
VITE_OIDC_ENABLED=false

# Invidious hosts for YouTube embeds, tried in order until one responds.
# Hostname only, no scheme. Comma separated, or a JSON array.
# Defaults to inv.nadeko.net, which is a third party's instance.
VITE_INVIDIOUS_INSTANCES=inv.nadeko.net,yewtu.be
